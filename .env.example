# ==============================================================================
# BhuVerify: Environment Configuration Template
# ==============================================================================

# Cryptographic token signing secret (generate a secure 256-bit random string)
SECRET_KEY=change-to-a-secure-random-256-bit-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database connection string
DATABASE_URL=sqlite:///./bhuverify.db

# Optional: Path to Tesseract executable if not in system PATH
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example:   TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# Secure upload directory (stored outside frontend public directory)
UPLOAD_DIR=backend/storage/uploads

# Environment: development / staging / production
ENVIRONMENT=development

# Frontend Public Base URL (used for QR code verify links)
PUBLIC_BASE_URL=http://localhost:5173

# Frontend Vite API URL (used by React app)
VITE_API_URL=http://localhost:8000

# Default expiration for public QR share tokens (in hours, e.g. 168 = 7 days)
DEFAULT_SHARE_TOKEN_EXPIRE_HOURS=168
